# ── Environment & secrets ──────────────────────────────────────────
# .env.example is tracked (it documents required vars); every other
# .env* file is ignored — covers .env, .env.local, .env.production,
# .env.staging, .env.*.local, etc.
.env
.env.*
!.env.example

# ── Per-project ignore extensions ──────────────────────────────────
# `.gitignore.local` is the extension point for project-specific ignore
# patterns that don't belong in the template. Git does NOT read this
# file by itself — `scripts/install-hooks.sh` wires it in by symlinking
# the per-clone `.git/info/exclude` to it. The script only links when
# `.gitignore.local` exists and info/exclude is still Git's default
# stub (custom excludes are preserved, and linked worktrees are skipped
# since they share info/exclude) — so if you create `.gitignore.local`
# later, rerun the script from the primary checkout. The template
# ignores the file so it never lands in git. This
# lets `update-project-from-template` overwrite .gitignore freely
# without clobbering project-only entries. See the CLAUDE.md convention
# block for the migration pattern.
.gitignore.local

# ── macOS ──────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.apdisk

# ── Editors / IDEs ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Rust ───────────────────────────────────────────────────────────
target/
Cargo.lock.bak
**/*.rs.bk

# ── Node / JavaScript / TypeScript ─────────────────────────────────
node_modules/
dist/
build/
.next/
.nuxt/
.svelte-kit/
.vite/
.turbo/
.parcel-cache/
*.tsbuildinfo
.npm/

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Logs ───────────────────────────────────────────────────────────
*.log
logs/

# ── SQLite databases (blanket) ─────────────────────────────────────
# Local state only — authoritative copies of chainlink/deciduous DBs
# live in the R2 backups the pre-commit hook uploads (ADR 0002). Blanket
# pattern also catches any future app-level sqlite files without needing
# to touch this list.
*.db
*.db-shm
*.db-wal

# ── Claude Code per-clone state ────────────────────────────────────
.claude/settings.local.json

# ── Deciduous local state ──────────────────────────────────────────
# Everything under .deciduous/ is local ephemeral state (the DB is
# covered by *.db above; config/documents are regenerated by deciduous
# itself). .gitkeep is re-included so the directory survives a fresh
# checkout.
.deciduous/*
!.deciduous/.gitkeep

# ── Chainlink local state ──────────────────────────────────────────
# issues.db is covered by *.db above. issues-export.json is the JSON the
# pre-commit hook regenerates from it on every commit; it is NOT committed
# (ADR 0005) — the hook checks this rule with `git check-ignore` and skips
# staging when it matches. The DB backup in R2 is the off-machine copy.
.chainlink/.cache/
.chainlink/issues-export.json
