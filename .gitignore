# ── Environment & secrets ──────────────────────────────────────────
# .env.example is tracked (it documents required vars); every other
# .env* file is ignored — covers .env, .env.local, .env.production,
# .env.staging, .env.*.local, etc.
.env
.env.*
!.env.example

# ── Per-project ignore extensions ──────────────────────────────────
# `.gitignore.local` is the extension point for project-specific ignore
# patterns that don't belong in the template. The template ignores it
# so it never lands in git, and git respects its patterns locally like
# a normal .gitignore. This lets `update-project-from-template` overwrite
# .gitignore freely without clobbering project-only entries. See the
# CLAUDE.md convention block for the migration pattern.
.gitignore.local

# ── macOS ──────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.apdisk

# ── Editors / IDEs ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Rust ───────────────────────────────────────────────────────────
target/
Cargo.lock.bak
**/*.rs.bk

# ── Node / JavaScript / TypeScript ─────────────────────────────────
node_modules/
dist/
build/
.next/
.nuxt/
.svelte-kit/
.vite/
.turbo/
.parcel-cache/
*.tsbuildinfo
.npm/

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Logs ───────────────────────────────────────────────────────────
*.log
logs/

# ── SQLite databases (blanket) ─────────────────────────────────────
# Local state only — authoritative copies of chainlink/deciduous DBs
# live in Tigris backups. Blanket pattern also catches any future
# app-level sqlite files without needing to touch this list.
*.db
*.db-shm
*.db-wal

# ── Claude Code per-clone state ────────────────────────────────────
.claude/settings.local.json

# ── Deciduous local state ──────────────────────────────────────────
# Everything under .deciduous/ is local ephemeral state (the DB is
# covered by *.db above; config/documents are regenerated by deciduous
# itself). .gitkeep is re-included so the directory survives a fresh
# checkout.
.deciduous/*
!.deciduous/.gitkeep

# Research scratch files
/docs/research/

# Chainlink local state. NOTE: there is NO automatic backup unless the four
# BACKUP_S3_* vars are set in .env (see .env.example) — when they are unset
# the pre-commit hook prints "Backup not configured" and skips the upload,
# a notice that is easy to miss. Target is Cloudflare R2.
# issues.db is per-clone; issues-export.json is the shared recovery source.
.chainlink/issues.db
.chainlink/.cache/
.chainlink/issues-export.json

# Git worktrees (local ephemeral state)
.worktrees/
.claude/worktrees/

# Downloaded ML model artifacts — fetched via `charcoal download-model`,
# never committed (the binary blobs are ~210 MB and derivable from
# upstream Hugging Face releases)
models/

# Python bytecode + pytest cache (e.g. gpu/cope-b-runpod test runs)
__pycache__/
*.pyc
.pytest_cache/

# Superpowers brainstorm session scratch — ephemeral local server state
# (.server.pid/.log, generated HTML mockups). Installed skills live under
# .agents/skills and .claude/skills, which ARE tracked.
.superpowers/
